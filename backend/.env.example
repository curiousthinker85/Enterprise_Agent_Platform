APP_NAME="Enterprise Agent Platform"
APP_VERSION=0.1.0
ENVIRONMENT=dev
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000"]
LITELLM_LOCAL_MODEL_COST_MAP=True

# Cloud provider example
DEFAULT_LLM_PROVIDER=openai
DEFAULT_LLM_MODEL=gpt-4o-mini
DEFAULT_LLM_API_KEY=
DEFAULT_LLM_API_BASE=
DEFAULT_LLM_API_VERSION=

# For local Ollama instead use:
# DEFAULT_LLM_PROVIDER=ollama
# DEFAULT_LLM_MODEL=ollama/llama3.2
# DEFAULT_LLM_API_BASE=http://localhost:11434

LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024
REQUEST_TIMEOUT_SECONDS=60

AUTH_SECRET_KEY=change-this-development-secret-before-production
AUTH_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
